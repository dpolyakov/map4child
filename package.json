{
  "name": "map4child",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "data:sync": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/sync-data.ts",
    "data:demo": "node --import tsx scripts/demo-data.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "build": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/verify-catalog.ts && vite build && node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/check-dist.ts",
    "build:demo": "MAP4CHILD_ALLOW_DEMO=1 npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "editor:build": "node --import tsx scripts/build-editor.ts",
    "data:seed-demo": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@gravity-ui/uikit": "8.0.0",
    "@yandex/ymaps3-clusterer": "0.0.13",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@googleapis/sheets": "18.1.1",
    "@types/leaflet": "1.9.22",
    "@types/leaflet.markercluster": "1.5.6",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "@yandex/ymaps3-types": "1.0.21772363",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
